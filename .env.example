# Browser settings. Use your Supabase project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760
# Server and worker only. Never prefix private keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Select photoroom or local explicitly. With no Photoroom key, drafts remain recoverable.
BACKGROUND_PROVIDER=photoroom
PHOTOROOM_API_KEY=
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=24000000
MAX_ITEMS_PER_ACCOUNT=500
MAX_PHOTOS_PER_DAY=50
# Recommendations run locally without an LLM or optional AI credential.
